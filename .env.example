# ── SMTP ──────────────────────────────────────────────────────────────────
# moskalova.com mail is on Google Workspace, so send through Google:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   SMTP_USER=<a Workspace mailbox, e.g. noreply@moskalova.com>
#   SMTP_PASSWORD=<an App Password for that mailbox — NOT the login password>
# Leave SMTP_HOST empty in development to use a throwaway Ethereal inbox
# (preview links are printed in the dev server console and returned by the API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sender shown to recipients. Must be the SMTP_USER mailbox itself or one of
# its verified "Send mail as" aliases in Gmail, otherwise Google rewrites it.
SMTP_FROM="Natalia Moskalova Photography <noreply@moskalova.com>"

# Where contact-form submissions are delivered (the photographer's inbox).
# Replies to the visitor's confirmation email also land here.
CONTACT_TO=

# Language of the notification emails sent to the photographer (en | uk).
CONTACT_OWNER_LOCALE=en

# Public site origin — used in the confirmation signature and, in production,
# to reject form posts coming from other origins.
SITE_URL=https://moskalova.com
